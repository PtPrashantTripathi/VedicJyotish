{
    "name": "vedicjyotish",
    "version": "1.0.4",
    "private": true,
    "homepage": "https://github.com/ptprashanttripathi/VedicJyotish",
    "bugs": {
        "url": "https://github.com/ptprashanttripathi/VedicJyotish/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ptprashanttripathi/VedicJyotish.git"
    },
    "license": "MIT",
    "author": {
        "name": "Pt. Prashant Tripathi",
        "url": "https://github.com/ptprashanttripathi",
        "githubUsername": "ptprashanttripathi"
    },
    "sideEffects": false,
    "type": "module",
    "main": "index.html",
    "scripts": {
        "all": "npm run build && npm run format && npm run lint && npm run typecheck",
        "build": "npm run build:database && npm run build:wasm && npm run build:vite",
        "build:database": "python3 tools/generate_database.py",
        "build:dev": "npm run build && npm run build:devtool",
        "build:devtool": "python3 tools/gen_devtools_json.py",
        "build:vite": "tsc -b && vite build",
        "build:wasm": "python3 tools/build_wasm.py",
        "dev": "vite",
        "format": "npm run format:js && npm run format:python",
        "format:js": "prettier . --write",
        "format:python": "isort . && black .",
        "lint": "eslint . --fix",
        "preview": "vite preview",
        "start": "vite start",
        "typecheck": "tsc --noEmit --incremental false"
    },
    "devDependencies": {
        "@eslint/js": "latest",
        "@tailwindcss/vite": "^4.1.11",
        "@types/emscripten": "latest",
        "@types/luxon": "latest",
        "@types/node": "latest",
        "@types/pako": "latest",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "@typescript-eslint/parser": "latest",
        "@vite-pwa/assets-generator": "^1.0.0",
        "@vitejs/plugin-react": "latest",
        "autoprefixer": "latest",
        "eslint": "latest",
        "eslint-config-prettier": "latest",
        "eslint-plugin-react-hooks": "latest",
        "eslint-plugin-react-refresh": "latest",
        "eslint-plugin-simple-import-sort": "latest",
        "eslint-plugin-unused-imports": "latest",
        "globals": "latest",
        "lucide-react": "^0.539.0",
        "luxon": "latest",
        "pako": "latest",
        "prettier": "latest",
        "prettier-plugin-jsdoc": "latest",
        "react": "latest",
        "react-dom": "latest",
        "react-icons": "latest",
        "tailwindcss": "^4.1.11",
        "tw-animate-css": "^1.3.7",
        "typescript": "latest",
        "typescript-eslint": "latest",
        "vite": "latest",
        "vite-plugin-pwa": "^1.0.1",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "engines": {
        "node": ">=22"
    },
    "typeScriptVersion": "latest"
}
