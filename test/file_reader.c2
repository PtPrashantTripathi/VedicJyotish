// Define standard types normally found in headers
typedef unsigned long size_t;
typedef long ssize_t;
#define NULL ((void*)0)
#define SEEK_SET 0
#define SEEK_CUR 1
#define SEEK_END 2

// Declare imported functions from the host environment
// The `__attribute__((import_module(...), import_name(...)))` tells the
// compiler to generate an import instruction in the WebAssembly module
// for these functions, instead of a call to a missing function.

__attribute__((import_module("console"), import_name("log")))
void printf_shim(const char* s);

__attribute__((import_module("env"), import_name("fopen_shim")))
void* fopen_shim(const char* filename, const char* mode);

__attribute__((import_module("env"), import_name("fread_shim")))
size_t fread_shim(void* ptr, size_t size, size_t count, void* stream);

__attribute__((import_module("env"), import_name("fclose_shim")))
int fclose_shim(void* stream);

__attribute__((import_module("env"), import_name("fseek_shim")))
int fseek_shim(void* stream, long offset, int whence);

__attribute__((import_module("env"), import_name("ftell_shim")))
long ftell_shim(void* stream);

__attribute__((import_module("env"), import_name("malloc_shim")))
void* malloc_shim(size_t size);

// A simple manual implementation of strlen for this freestanding environment
size_t custom_strlen(const char *str) {
    const char *s;
    for (s = str; *s; ++s);
    return(s - str);
}

// Export function to be visible in WebAssembly
__attribute__((export_name("read_file")))
char* read_file(const char* path) {
    void *file = fopen_shim(path, "r");
    if (!file) {
        printf_shim("Error: Unable to open file\n");
        return NULL;
    }

    // Seek to end to determine size
    fseek_shim(file, 0, SEEK_END);
    long size = ftell_shim(file);
    fseek_shim(file, 0, SEEK_SET);

    // Allocate buffer in WASM memory
    char *buffer = (char*)malloc_shim(size + 1);
    if (!buffer) {
        printf_shim("Error: Memory allocation failed\n");
        fclose_shim(file);
        return NULL;
    }

    fread_shim(buffer, 1, size, file);
    buffer[size] = '\0'; // Null terminator
    fclose_shim(file);

    // Print to stdout (WASM console)
    printf_shim(buffer);

    return buffer;
}
